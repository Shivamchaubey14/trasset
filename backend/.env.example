# Trasset — environment configuration (SRS §11.3)
# Copy to .env and fill in real values. Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (MySQL 8.x) ---
DB_NAME=trasset
DB_USER=trasset
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- JWT ---
JWT_ACCESS_MIN=15
JWT_REFRESH_DAYS=7
# Mobile clients (X-Client: mobile) get a longer refresh — SRS §12.4, BE-1
JWT_MOBILE_REFRESH_DAYS=30

# --- Login lockout (FR-1.5) ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- CORS (SEC-6) ---
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
FRONTEND_URL=http://127.0.0.1:5500

# --- Email (FR-12.2) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Trasset <no-reply@trasset.local>

# --- Push notifications (SRS §12.4, BE-3) ---
# Console logs instead of sending; swap for ExpoPushBackend in production.
PUSH_BACKEND=apps.notifications.push.ConsolePushBackend
EXPO_ACCESS_TOKEN=

# --- Celery / Redis (SRS §10.4) ---
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=True

# --- Domain ---
ASSET_TAG_PREFIX=TRA
