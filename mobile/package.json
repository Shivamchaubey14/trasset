{
  "name": "trasset-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "tunnel": "expo start --tunnel",
    "tsc": "tsc --noEmit",
    "gen:api": "openapi-typescript http://127.0.0.1:8000/api/schema/ -o src/api/schema.d.ts",
    "verify:api": "tsx scripts/verify-client.ts",
    "verify:scan": "tsx scripts/verify-scan.ts",
    "verify:detail": "tsx scripts/verify-detail.ts",
    "verify:list": "tsx scripts/verify-list.ts",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@expo-google-fonts/lexend": "^0.4.1",
    "@expo-google-fonts/quicksand": "^0.4.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.10",
    "@tanstack/react-query": "^5.62.0",
    "expo": "~54.0.0",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-local-authentication": "~17.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.1",
    "typescript": "~5.9.2"
  }
}
